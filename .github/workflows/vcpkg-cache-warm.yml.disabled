# ==========================================================================
# DISABLED -- kept for later, not enabled yet.
#
# Disabled by the ".disabled" file extension, not by commenting out the body.
# GitHub validates every *.yml / *.yaml under .github/workflows/ on push, so a
# fully commented-out workflow is an INVALID workflow rather than an absent
# one: no `on:` means it produces a failed run named after its own path on
# every push (run 32810358729).  Only the extension makes GitHub skip the file.
#
# To enable: rename back to vcpkg-cache-warm.yml.
# ==========================================================================

name: Warm vcpkg binary cache

# GitHub evicts caches that go unused for 7 days, and this repo only builds on
# tags -- so without this the release build would almost always hit a cold cache
# and pay the full dependency build again.  This job does nothing but keep the
# archives alive.  Caches created on the default branch are restorable from any
# other ref, including tag refs, so warming from main warms the release path.
#
# The runs-on image and the cache key expressions must stay identical to
# windows.yml: the MSVC toolset is part of every package's ABI hash.
on:
  schedule:
    - cron: '0 4 * * 1'
  workflow_dispatch:

permissions:
  contents: read

env:
  FORCE_JAVASCRIPT_ACTIONS_TO_NODE24: true
  VCPKG_TARGET_TRIPLET: x64-windows-release
  VCPKG_DISABLE_METRICS: '1'

jobs:
  warm:
    runs-on: windows-latest

    steps:
      - name: Checkout manifest only
        uses: actions/checkout@v5
        with:
          fetch-depth: 1
          sparse-checkout: src/vcpkg.json
          sparse-checkout-cone-mode: false

      - name: Restore vcpkg binary cache
        id: vcpkg-cache
        uses: actions/cache/restore@v4
        with:
          path: ~\AppData\Local\vcpkg\archives
          key: vcpkg-${{ env.VCPKG_TARGET_TRIPLET }}-${{ hashFiles('src/vcpkg.json') }}-${{ github.run_id }}-${{ github.run_attempt }}
          restore-keys: |
            vcpkg-${{ env.VCPKG_TARGET_TRIPLET }}-${{ hashFiles('src/vcpkg.json') }}-
            vcpkg-${{ env.VCPKG_TARGET_TRIPLET }}-

      - name: Install dependencies (vcpkg)
        shell: pwsh
        run: |
          $ErrorActionPreference = 'Stop'
          $baseline = (Get-Content src\vcpkg.json -Raw | ConvertFrom-Json).'builtin-baseline'
          git -C $env:VCPKG_INSTALLATION_ROOT cat-file -e "$baseline^{commit}" 2>$null
          if ($LASTEXITCODE -ne 0) {
            git -C $env:VCPKG_INSTALLATION_ROOT fetch --depth=1 origin $baseline
            if ($LASTEXITCODE -ne 0) { throw "Could not fetch vcpkg baseline $baseline" }
          }

          vcpkg install `
            --x-manifest-root=src `
            --x-install-root="$PWD\build\vcpkg_installed" `
            --triplet $env:VCPKG_TARGET_TRIPLET `
            --clean-after-build
          if ($LASTEXITCODE -ne 0) { throw "vcpkg install failed ($LASTEXITCODE)" }

      # Always re-save: the point is to refresh the 7-day eviction clock, so a run
      # that restored everything and rebuilt nothing still needs to write a new
      # entry under a new key.
      - name: Save vcpkg binary cache
        if: always()
        uses: actions/cache/save@v4
        with:
          path: ~\AppData\Local\vcpkg\archives
          key: vcpkg-${{ env.VCPKG_TARGET_TRIPLET }}-${{ hashFiles('src/vcpkg.json') }}-${{ github.run_id }}-${{ github.run_attempt }}
