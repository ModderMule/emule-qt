# Copy to docker/natt/natnet.env (git-ignored) and point at your local copies.
# The server binaries and checkouts stay outside this repo.

# Lugdunum eserver 17.x, the i686 Linux build (runs under qemu-i386)
NATNET_LUGDUNUM_BIN=~/Documents/Coding/Projects/Sharing/eNode-go/lugdunum-eserver/bin/eserver-17.15.i686-linux

# ed2k-server: the checkout (built in a rust container; also supplies config/config.toml),
# or a prebuilt Linux binary plus a config template
NATNET_ED2K_SERVER_SRC=~/Documents/Coding/Rust/ed2k-server
#NATNET_ED2K_SERVER_BIN=
#NATNET_ED2K_SERVER_CONFIG=

# eNode-go: the checkout (cross-built with the host's go; also supplies enode.config.yaml),
# or a prebuilt Linux binary plus a config template
NATNET_ENODE_SRC=~/Documents/Coding/Projects/Sharing/eNode-go
#NATNET_ENODE_BIN=
#NATNET_ENODE_CONFIG=

# Build outputs, run dirs, logs and packet captures (default ~/.cache/emuleqt-natnet)
#NATNET_WORK=
