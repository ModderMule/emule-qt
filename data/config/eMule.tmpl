.graph-title { background: #003C6E; color: #FFFFFF; font-size: 8pt; font-weight: bold; padding: 3px 6px; }
.graph-svg { display: block; width: 100%; height: 120px; }
.graph-scale { color: #C0C0FF; font-size: 7pt; padding: 2px 6px 8px 6px; }
