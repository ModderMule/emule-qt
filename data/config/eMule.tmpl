</div>
<div class="msg-wrap">
 <div class="msg-friends">
  <div class="smallheader">{{Friends}} ([FriendCount])</div>
  <div data-live="friends">
  <table class="data-table" data-filter="friends">
   <thead><tr><th class="left">{{Name}}</th><th>{{Status}}</th><th class="opt">{{Last Seen}}</th></tr></thead>
   <tbody>[FriendLines]</tbody>
  </table>
  </div>
  <form action="/" method="POST" class="search-form add-friend admin-only">
   <input type="hidden" name="w" value="messages">
   <input type="hidden" name="op" value="addfriend">
   <b>{{Add Friend}}</b><br>
   <input type="text" name="name" placeholder="{{Name}}" aria-label="{{Name}}">
   <input type="text" name="hash" placeholder="{{User hash}}" aria-label="{{User hash}}" maxlength="32"><br>
   <input type="text" name="addr" placeholder="{{IP address}}" aria-label="{{IP address}}">
   <input type="text" name="port" placeholder="{{Port}}" aria-label="{{Port}}" size="6">
   <input type="submit" value="{{Add}}" [FormOff]>
  </form>
 </div>
 <div class="msg-chat">
  <div class="smallheader">[ChatTitle]</div>
  <div class="chat-log" id="chat-log" data-live="chat" data-stick-end>[ChatLines]</div>
  <form action="/" method="POST" class="ajax chat-form" data-reset [ChatHidden]>
   <input type="hidden" name="w" value="messages">
   <input type="hidden" name="op" value="send">
   <input type="hidden" name="peer" value="[ChatPeer]">
   <input type="text" name="text" maxlength="450" autocomplete="off" placeholder="{{Type a message…}}" aria-label="{{Message}}" [FormOff]>
   <input type="submit" value="{{Send}}" [FormOff]>
  </form>
  <div class="admin-only" [ChatHidden]>
   <a href="#" data-post="w=messages&amp;op=clearchat&amp;peer=[ChatPeer]&amp;ret=messages%26peer%3D[ChatPeer]" onclick="return act(this)">{{Clear}}</a>
   <span id="chat-unfriend" [ChatHidden]>&nbsp;|&nbsp; <a href="#" data-post="w=messages&amp;op=removefriend&amp;peer=[ChatPeer]" data-q="{{Remove this friend?}}" onclick="return act(this)">{{Remove Friend}}</a></span>
  </div>
 </div>
</div>
<script>
(function(){
 if(!ADMIN)document.querySelectorAll('.page-content .admin-only').forEach(function(x){x.hidden=true;});
 if('[ChatIsFriend]'!=='1'){var u=document.getElementById('chat-unfriend');if(u)u.hidden=true;}
 var log=document.getElementById('chat-log');if(log)log.scrollTop=log.scrollHeight;
 var box=document.querySelector('.chat-form input[name=text]');if(box&&!box.disabled)box.focus();
})();
</script>
