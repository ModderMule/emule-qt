     <line x1="0" y1="60" x2="500" y2="60" stroke="#C0C0FF" stroke-opacity="0.3" stroke-dasharray="2 4"/>
     <line x1="0" y1="90" x2="500" y2="90" stroke="#C0C0FF" stroke-opacity="0.3" stroke-dasharray="2 4"/>
