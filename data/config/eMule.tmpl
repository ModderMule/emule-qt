 <td class="center"><a href="#" class="admin-only" data-post="w=scheduler&amp;op=remove&amp;i=[ScheduleIndex]" data-q="{{Remove this schedule?}}" onclick="return act(this)">{{Remove}}</a></td>
</tr>
