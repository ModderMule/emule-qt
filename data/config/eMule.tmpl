  <a class="nav-link [Page_log]" href="?ses=[ses]&amp;w=log"><span class="icon icon-h_log" style="vertical-align:middle"></span>&nbsp;{{Log}}</a><br>
  <a class="nav-link [Page_debuglog]" href="?ses=[ses]&amp;w=debuglog"><span class="icon icon-h_log" style="vertical-align:middle"></span>&nbsp;{{Debug}}</a><br>
  <a class="nav-link [Page_myinfo]" href="?ses=[ses]&amp;w=myinfo"><span class="icon icon-l_info" style="vertical-align:middle"></span>&nbsp;{{My Info}}</a>
 </div>
