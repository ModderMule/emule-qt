     <line x1="0" y1="30" x2="500" y2="30" stroke="#C0C0FF" stroke-opacity="0.3" stroke-dasharray="2 4"/>
     <line x1="0" y1="60" x2="500" y2="60" stroke="#C0C0FF" stroke-opacity="0.3" stroke-dasharray="2 4"/>
     <line x1="0" y1="90" x2="500" y2="90" stroke="#C0C0FF" stroke-opacity="0.3" stroke-dasharray="2 4"/>
     <polyline fill="none" stroke="#80FF80" stroke-width="1.5" vector-effect="non-scaling-stroke" points="[GraphDownloadPts]"/>
    </svg>
   </div>
   <div class="graph-scale">[TxtTime]: [ScaleTime]</div>
  </td>
 </tr>
 <tr>
  <td>
   <div class="graph-title">[TxtUpload] &mdash; 0&ndash;[MaxUpload] [KByteSec]</div>
   <div class="graph-box">
    <svg class="graph-svg" viewBox="0 0 500 120" preserveAspectRatio="none" data-values="[GraphUpload]">
