<!DOCTYPE html>
<html lang="[HtmlLang]">
<head>
<meta charset="[CharSet]">
<meta http-equiv="pragma" content="no-cache">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#003C6E">
<link rel="icon" href="favicon.ico">
<link rel="manifest" href="manifest.webmanifest">
<link rel="apple-touch-icon" href="app-icon-180.png">
<link rel="stylesheet" href="sprites.css">
<link rel="stylesheet" href="sprite-rating.css">
<title>[eMuleAppName] [version] - [WebControl]</title>
<script>
// Per-browser conveniences only; every read and write may fail (private window).
function sget(k,ses){try{return (ses?sessionStorage:localStorage).getItem(k);}catch(e){return null;}}
function sset(k,v,ses){try{(ses?sessionStorage:localStorage).setItem(k,v);}catch(e){}}
// Theme before the first paint: auto follows the system, dark or the classic blue.
var EMQ_THEME=sget('emqTheme')||'auto';
function applyTheme(t){var d=t;if(t==='auto')d=window.matchMedia&&matchMedia('(prefers-color-scheme: dark)').matches?'dark':'classic';document.documentElement.setAttribute('data-theme',d);}
function setTheme(t){EMQ_THEME=t;sset('emqTheme',t);applyTheme(t);}
applyTheme(EMQ_THEME);
if(window.matchMedia){var mq=matchMedia('(prefers-color-scheme: dark)');if(mq.addEventListener)mq.addEventListener('change',function(){if(EMQ_THEME==='auto')applyTheme('auto');});}
</script>
[StyleSheet]
<script>
var ADMIN='[IsAdmin]'==='1';
var activeMenu=null;
function showMenu(e,m){
 hideMenu();m.style.display='block';activeMenu=m;
 // kept on screen: a menu opened near the right edge or on a phone moves left
 var x=e.pageX,maxX=window.scrollX+document.documentElement.clientWidth-m.offsetWidth-4;
 m.style.left=Math.max(window.scrollX+4,Math.min(x,maxX))+'px';m.style.top=e.pageY+'px';
 e.preventDefault();
}
function hideMenu(){if(activeMenu){activeMenu.style.display='none';activeMenu=null;}}
document.addEventListener('click',hideMenu);

// Labels arrive as plain text in the page's language; every one is escaped on its way into markup.
function esc(s){return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');}
// "%1".."%9" in a translated sentence.
function emqFmt(s){var a=arguments;return String(s).replace(/%(\d)/g,function(m,i){return a[+i]==null?'':String(a[+i]);});}
function ic(n){return '<span class="icon icon-'+n+'"></span> ';}
// State changes are POSTed with the session cookie; nothing that acts is a link.
function post(q){var f=document.createElement('form');f.method='POST';f.action='/';new URLSearchParams(q).forEach(function(v,k){var i=document.createElement('input');i.type='hidden';i.name=k;i.value=v;f.appendChild(i);});document.body.appendChild(f);f.submit();return false;}
function act(a){if(a.dataset.q&&!confirm(a.dataset.q))return false;return post(a.dataset.post);}
function mi(q,icon,label,question){return '<a class="menuitems" href="#" data-post="'+esc(q)+'"'+(question?' data-q="'+esc(question)+'"':'')+' onclick="return act(this)">'+ic(icon)+esc(label)+'</a>';}
var SEP='<div class="menusep"></div>';
// Set by pages that offer Preview; the link plays in the browser or can be copied into a media player.
var STREAM_TOKEN='';
function previewItem(path){return STREAM_TOKEN?'<a class="menuitems" href="'+esc(path+'?token='+encodeURIComponent(STREAM_TOKEN))+'" target="_blank" onclick="hideMenu()">'+ic('filetype_video')+esc('{{js:Preview}}')+'</a>'+SEP:'';}
function setlang(code){var q=new URLSearchParams(location.search);q.set('setlang',code);location.search=q.toString();}

// --- notices
function toast(msg,err){
 if(!msg)return;
 var box=document.getElementById('toasts');if(!box)return;
 var t=document.createElement('div');t.className='toast'+(err?' failed':'');t.textContent=msg;
 t.onclick=function(){t.remove();};box.appendChild(t);
 setTimeout(function(){t.classList.add('gone');setTimeout(function(){t.remove();},400);},err?9000:5000);
}

// --- live updates: the page's [data-live] parts are fetched again and swapped in place,
// keeping scroll positions and ticked boxes. The page is never reloaded.
var LIVE={busy:false};
function curPage(){return new URLSearchParams(location.search).get('w')||'transfer';}
// where an action sends the page back to: this page, and the open conversation
function curRet(){var q=new URLSearchParams(location.search),r=curPage();if(q.get('peer'))r+='&peer='+q.get('peer');return r;}
function liveRegions(){return document.querySelectorAll('[data-live]');}
function liveUrl(){var q=new URLSearchParams(location.search);q.delete('setlang');if(STREAM_TOKEN)q.set('st',STREAM_TOKEN);return '/?'+q.toString();}
function liveApply(html){
 var doc=new DOMParser().parseFromString(html,'text/html');
 // the login page instead: the session ran out
 if(doc.querySelector('form[name=login]')){location.reload();return;}
 liveRegions().forEach(function(old){
  var neu=doc.querySelector('[data-live="'+old.getAttribute('data-live')+'"]');if(!neu)return;
  var ticked={};old.querySelectorAll('input[type=checkbox]').forEach(function(c){if(c.name&&c.value)ticked[c.name+'\n'+c.value]=c.checked;});
  var sc=old.scrollTop,atEnd=old.scrollHeight-old.scrollTop-old.clientHeight<8;
  old.innerHTML=neu.innerHTML;
  old.querySelectorAll('input[type=checkbox]').forEach(function(c){var k=c.name+'\n'+c.value;if(k in ticked)c.checked=ticked[k];});
  old.scrollTop=old.hasAttribute('data-stick-end')&&atEnd?old.scrollHeight:sc;
 });
 doc.querySelectorAll('#ui-notice,[data-notice] p').forEach(function(n){toast(n.textContent,n.classList.contains('failed'));});
 document.dispatchEvent(new Event('emq:live'));
}
function liveRefresh(){
 if(LIVE.busy||!liveRegions().length)return;
 LIVE.busy=true;
 fetch(liveUrl(),{cache:'no-store',credentials:'same-origin'}).then(function(r){return r.text();})
  .then(liveApply).catch(function(){}).then(function(){LIVE.busy=false;});
}
function liveBlocked(){
 if(document.hidden||activeMenu||DROP.on)return true;
 // typing inside a part that would be swapped
 var a=document.activeElement;
 return !!(a&&a.closest&&a.closest('[data-live]')&&/INPUT|TEXTAREA|SELECT/.test(a.tagName)&&a.type!=='checkbox');
}
setInterval(function(){if(!liveBlocked())liveRefresh();},3000);

// An action without leaving the page: the answer is this page again, swapped in.
function ajaxPost(body){
 if(!(body instanceof FormData)&&!(body instanceof URLSearchParams))body=new URLSearchParams(body);
 if(!body.has('ret'))body.append('ret',curRet());
 LIVE.busy=true;
 return fetch('/',{method:'POST',credentials:'same-origin',body:body}).then(function(r){return r.text();})
  .then(liveApply).catch(function(){toast('{{js:Could not reach the eMule core.}}',true);})
  .then(function(){LIVE.busy=false;});
}
// <form class="ajax">: the pressed button's name/value travels along; data-reset empties it after.
document.addEventListener('submit',function(e){
 var f=e.target;if(!f.classList||!f.classList.contains('ajax'))return;
 e.preventDefault();
 var b=e.submitter,fd=new FormData(f);
 if(b&&b.name)fd.set(b.name,b.value);
 if(f.classList.contains('bulk')&&!f.querySelector('tbody input[type=checkbox]:checked')){toast('{{js:Tick one or more rows first.}}',true);return;}
 var files=f.querySelector('input[type=file]');
 ajaxPost(files?fd:new URLSearchParams(fd)).then(function(){if(f.hasAttribute('data-reset'))f.reset();});
});
// A bulk menu (priority, category): its option value is "op" or "op:cat".
function bulkSelect(sel){
 var f=sel.form,v=sel.value;sel.selectedIndex=0;if(!v)return;
 if(!f.querySelector('tbody input[type=checkbox]:checked')){toast('{{js:Tick one or more rows first.}}',true);return;}
 var fd=new URLSearchParams(new FormData(f)),p=v.split(':');fd.set('op',p[0]);if(p.length>1)fd.set('cat',p[1]);
 ajaxPost(fd);
}
document.addEventListener('change',function(e){
 var c=e.target;if(!c.classList||!c.classList.contains('checkall'))return;
 var f=c.closest('form');if(!f)return;
 f.querySelectorAll('tbody tr:not([hidden]) input[type=checkbox]').forEach(function(x){x.checked=c.checked;});
});

// --- list filter: a text box and a status menu above every table marked data-filter
function filterInit(){
 document.querySelectorAll('table[data-filter]').forEach(function(t){
  var key=t.getAttribute('data-filter'),bar=document.querySelector('.filterbar[data-for="'+key+'"]');
  if(!bar){
   var host=t.closest('[data-live]')||t;
   bar=document.createElement('div');bar.className='filterbar';bar.setAttribute('data-for',key);
   bar.innerHTML='<input type="search" class="flt-text" placeholder="'+esc('{{js:Filter}}')+'" aria-label="'+esc('{{js:Filter}}')+'">'
    +' <select class="flt-status" aria-label="'+esc('{{js:Status}}')+'"><option value="">'+esc('{{js:All}}')+'</option></select>'
    +' <span class="flt-count"></span>';
   host.parentNode.insertBefore(bar,host);
   bar.querySelector('.flt-text').value=sget('flt:'+key,true)||'';
   bar.dataset.status=sget('flts:'+key,true)||'';
   bar.querySelector('.flt-text').addEventListener('input',function(){sset('flt:'+key,this.value,true);filterApply(key);});
   bar.querySelector('.flt-status').addEventListener('change',function(){bar.dataset.status=this.value;sset('flts:'+key,this.value,true);filterApply(key);});
  }
  filterApply(key);
 });
}
function filterApply(key){
 var t=document.querySelector('table[data-filter="'+key+'"]'),bar=document.querySelector('.filterbar[data-for="'+key+'"]');
 if(!t||!bar||!t.tBodies.length)return;
 var txt=bar.querySelector('.flt-text').value.trim().toLowerCase(),st=bar.dataset.status||'',sel=bar.querySelector('.flt-status');
 var rows=[].slice.call(t.tBodies[0].rows).filter(function(r){return !r.classList.contains('flt-skip');});
 // the status menu lists what the rows have
 var names={},order=[];
 rows.forEach(function(r){var s=r.getAttribute('data-status');if(s&&!(s in names)){names[s]=r.getAttribute('data-status-text')||s;order.push(s);}});
 var want=order.join('|');
 if(sel.dataset.have!==want){
  sel.innerHTML='<option value="">'+esc('{{js:All}}')+'</option>'+order.map(function(s){return '<option value="'+esc(s)+'">'+esc(names[s])+'</option>';}).join('');
  sel.dataset.have=want;
 }
 sel.hidden=!order.length;
 if(st&&!(st in names))st='';
 sel.value=st;
 var shown=0;
 rows.forEach(function(r){var ok=(!txt||r.textContent.toLowerCase().indexOf(txt)>=0)&&(!st||r.getAttribute('data-status')===st);r.hidden=!ok;if(ok)shown++;});
 bar.querySelector('.flt-count').textContent=(txt||st)?emqFmt('{{js:%1 of %2 shown}}',shown,rows.length):'';
}
document.addEventListener('emq:live',filterInit);

// --- drag and drop, and paste: files and links go to the network that takes them
var DROP={on:false,depth:0};
function dropHas(e){var t=e.dataTransfer&&e.dataTransfer.types;return !!t&&[].some.call(t,function(x){return x==='Files'||x==='text/uri-list'||x==='text/plain';});}
function dropShow(on){DROP.on=on;var o=document.getElementById('dropzone');if(o)o.hidden=!on;}
function isLink(s){return /^(ed2k|ed3k):\/\/|^magnet:\?|^https?:\/\//i.test(s);}
function linksIn(text){return String(text||'').split(/[\s]+/).map(function(s){return s.trim();}).filter(isLink);}
function addThings(files,links){
 if(!ADMIN){toast('{{js:Guests cannot add downloads}}',true);return;}
 if(!files.length&&!links.length){toast('{{js:Nothing to add: drop .torrent, .nzb, .emulecollection or link container files, or ed2k, ed3k, magnet or web links.}}',true);return;}
 var fd=new FormData();fd.append('w','add');
 files.forEach(function(f){fd.append('files',f,f.name);});
 if(links.length)fd.append('links',links.join('\n'));
 toast(emqFmt('{{js:Adding %1 item(s)…}}',files.length+links.length));
 ajaxPost(fd);
}
document.addEventListener('dragenter',function(e){if(!dropHas(e))return;DROP.depth++;dropShow(true);e.preventDefault();});
document.addEventListener('dragover',function(e){if(DROP.on)e.preventDefault();});
document.addEventListener('dragleave',function(){if(DROP.on&&--DROP.depth<=0){DROP.depth=0;dropShow(false);}});
document.addEventListener('drop',function(e){
 if(!DROP.on)return;
 e.preventDefault();DROP.depth=0;dropShow(false);
 var dt=e.dataTransfer;
 addThings([].slice.call(dt.files||[]),dt.files&&dt.files.length?[]:linksIn(dt.getData('text/uri-list')||dt.getData('text/plain')));
});
document.addEventListener('paste',function(e){
 if(/INPUT|TEXTAREA|SELECT/.test((e.target||{}).tagName||'')||e.target.isContentEditable)return;
 var links=linksIn((e.clipboardData||window.clipboardData).getData('text'));
 if(links.length&&confirm(emqFmt('{{js:Add %1 pasted link(s)?}}',links.length)+'\n\n'+links.join('\n')))addThings([],links);
});

// --- header: speeds, unread messages and finished downloads, polled
var NOTIFY_ON=sget('emqNotify')==='1';
function canNotify(){return 'Notification' in window&&window.isSecureContext;}
function notify(title,body){
 toast(title+': '+body);
 if(NOTIFY_ON&&canNotify()&&Notification.permission==='granted'){try{new Notification(title,{body:body,icon:'app-icon-192.png'});}catch(e){}}
}
function notifyToggle(){
 hideMenu();
 if(NOTIFY_ON){NOTIFY_ON=false;sset('emqNotify','0');toast('{{js:Notifications off.}}');return;}
 if(!canNotify()){toast('{{js:Browser notifications need HTTPS, or the page opened as localhost. Pop-ups on this page still show.}}',true);NOTIFY_ON=true;sset('emqNotify','1');return;}
 Notification.requestPermission().then(function(p){
  NOTIFY_ON=p==='granted';sset('emqNotify',NOTIFY_ON?'1':'0');
  toast(NOTIFY_ON?'{{js:Notifications on: finished and failed downloads and new messages.}}':'{{js:The browser refused notifications.}}',!NOTIFY_ON);
 });
}
var SEEN=null;
function statusDiff(j){
 // the first poll of a tab only learns what is already there
 var now={};(j.done||[]).forEach(function(x){now['d'+x[0]]=x[1];});(j.failed||[]).forEach(function(x){now['f'+x[0]]=x[1];});
 if(!SEEN){try{SEEN=JSON.parse(sget('emqSeen',true)||'null');}catch(e){SEEN=null;}}
 if(SEEN){
  Object.keys(now).forEach(function(k){if(!(k in SEEN))notify(k[0]==='d'?'{{js:Download completed}}':'{{js:Download failed}}',now[k]);});
 }
 SEEN={};Object.keys(now).forEach(function(k){SEEN[k]=1;});
 sset('emqSeen',JSON.stringify(SEEN),true);
 // unread messages: counted from the last visit of the Messages page
 var inCount=+j.chatIn||0,seen=sget('emqChatSeen');
 if(seen===null||curPage()==='messages'||+seen>inCount){sset('emqChatSeen',String(inCount));seen=inCount;}
 var prev=+(sget('emqChatLast',true)||inCount);
 if(inCount>prev&&curPage()!=='messages')notify('{{js:New message}}',emqFmt('{{js:%1 unread}}',inCount-(+seen)));
 sset('emqChatLast',String(inCount),true);
 var b=document.getElementById('chat-badge');if(b){var n=inCount-(+seen);b.textContent=n>0?String(n):'';b.hidden=n<=0;}
}
function statusPoll(){
 if(document.hidden)return;
 fetch('/ui/status',{cache:'no-store',credentials:'same-origin'}).then(function(r){return r.ok?r.json():null;}).then(function(j){
  if(!j)return;
  var d=document.getElementById('hdr-down'),u=document.getElementById('hdr-up'),s=document.getElementById('hdr-server');
  if(d&&j.down!=null)d.textContent=j.down;if(u&&j.up!=null)u.textContent=j.up;if(s&&j.server!=null)s.textContent=j.server;
  var m=document.getElementById('speedmenu');
  if(m&&j.limitDown!=null){m.dataset.down=j.limitDown;m.dataset.up=j.limitUp;m.dataset.alt=j.altSpeed?'1':'0';}
  statusDiff(j);
 }).catch(function(){});
}
setInterval(statusPoll,5000);

// --- speed menu: presets of the line's capacity, own values, turtle mode
function speedPreset(kind,v){hideMenu();var q={w:'speed'};q[kind]=v;ajaxPost(q);}
function speedMenu(e){
 e.stopPropagation();
 var m=document.getElementById('speedmenu'),d=+m.dataset.down,u=+m.dataset.up,cd=+m.dataset.capdown,cu=+m.dataset.capup;
 function col(kind,label,cur,cap){
  var h='<div class="sm-col"><div class="sm-head">'+esc(label)+'</div>';
  h+='<a class="menuitems'+(cur===0?' sm-cur':'')+'" href="#" onclick="speedPreset(\''+kind+'\',0);return false;">'+esc('{{js:Unlimited}}')+'</a>';
  if(cap>0)[10,25,50,75,100].forEach(function(p){var v=Math.max(1,Math.round(cap*p/100));
   h+='<a class="menuitems'+(cur===v?' sm-cur':'')+'" href="#" onclick="speedPreset(\''+kind+'\','+v+');return false;">'+p+'% &middot; '+v+' '+esc('{{js:KB/s}}')+'</a>';});
  h+='<div class="sm-own"><input type="number" min="0" max="1000000" class="sm-'+kind+'" value="'+cur+'"> '+esc('{{js:KB/s}}')+'</div></div>';
  return h;
 }
 var h='<div class="sm-cols">'+col('maxdown','{{js:Download}}',d,cd)+col('maxup','{{js:Upload}}',u,cu)+'</div>'
  +'<div class="sm-foot"><label><input type="checkbox" id="sm-alt"'+(m.dataset.alt==='1'?' checked':'')+'> '+esc('{{js:Alternative speed (turtle)}}')+'</label>'
  +' <button type="button" id="sm-apply">'+esc('{{js:Apply}}')+'</button></div>';
 m.innerHTML=h;
 m.onclick=function(ev){ev.stopPropagation();};
 document.getElementById('sm-apply').onclick=function(){
  hideMenu();ajaxPost({w:'speed',maxdown:m.querySelector('.sm-maxdown').value,maxup:m.querySelector('.sm-maxup').value,
   alt:document.getElementById('sm-alt').checked?'1':'0'});
 };
 showMenu(e,m);
}

// --- app menu: install, magnet links, notifications
var INSTALL=null;
window.addEventListener('beforeinstallprompt',function(e){e.preventDefault();INSTALL=e;});
function appInstall(){
 hideMenu();
 if(INSTALL){INSTALL.prompt();INSTALL=null;return;}
 toast('{{js:Use the browser menu: Install app, or Share and Add to Home Screen. Browsers offer it on HTTPS or localhost.}}');
}
function magnetHandler(){
 hideMenu();
 try{navigator.registerProtocolHandler('magnet',location.origin+'/?w=addlink&link=%s');toast('{{js:Asked the browser to open magnet links here.}}');}
 catch(e){toast('{{js:This browser cannot open magnet links here (it needs HTTPS or localhost).}}',true);}
}
function appMenu(e){
 e.stopPropagation();
 var m=document.getElementById('appmenu');
 m.innerHTML='<a class="menuitems" href="#" onclick="notifyToggle();return false;">'+ic(NOTIFY_ON?'l_timer_off':'l_timer')+esc(NOTIFY_ON?'{{js:Turn notifications off}}':'{{js:Notify me of finished downloads}}')+'</a>'
  +'<a class="menuitems" href="#" onclick="magnetHandler();return false;">'+ic('l_ed2klink')+esc('{{js:Open magnet links here}}')+'</a>'
  +'<a class="menuitems" href="#" onclick="appInstall();return false;">'+ic('l_add')+esc('{{js:Install as app}}')+'</a>'
  +SEP+'<a class="menuitems" href="?w=addlink" onclick="hideMenu()">'+ic('l_add')+esc('{{js:Add Links…}}')+'</a>';
 showMenu(e,m);
}

// --- phones: a long press opens the row menus a right click opens
(function(){
 var t=null;
 document.addEventListener('touchstart',function(e){
  if(e.touches.length!==1)return;
  var tr=e.target.closest&&e.target.closest('tr[oncontextmenu],#un-list tr');if(!tr)return;
  var p=e.touches[0];
  t=setTimeout(function(){t=null;tr.dispatchEvent(new MouseEvent('contextmenu',{bubbles:true,cancelable:true,clientX:p.clientX,clientY:p.clientY,view:window}));},550);
 },{passive:true});
 ['touchend','touchmove','touchcancel'].forEach(function(n){document.addEventListener(n,function(){if(t){clearTimeout(t);t=null;}},{passive:true});});
})();

document.addEventListener('DOMContentLoaded',function(){
 var ts=document.getElementById('theme-select');if(ts)ts.value=EMQ_THEME;
 var n=document.getElementById('ui-notice');if(n)setTimeout(function(){n.hidden=true;},9000);
 filterInit();
 statusPoll();
});

function downmenu(e,hash,st){
 var m=document.getElementById('downmenu');
 var h='';
 var u='w=transfer&file='+encodeURIComponent(hash)+'&op=';
 h+=previewItem('/api/v1/downloads/'+encodeURIComponent(hash)+'/preview');
 if(st==='paused'||st==='stopped')
  h+=mi(u+'resume','l_resume','{{js:Resume}}');
 if(st==='downloading'||st==='waiting')
  h+=mi(u+'pause','l_pause','{{js:Pause}}')+mi(u+'stop','l_stop','{{js:Stop}}');
 if(st==='paused')
  h+=mi(u+'stop','l_stop','{{js:Stop}}');
 h+=SEP;
 h+=mi(u+'cancel','l_cancel','{{js:Cancel}}','{{js:Cancel this download?}}');
 h+=SEP;
 h+=mi(u+'priolow','low','{{js:Priority: Low}}');
 h+=mi(u+'prionormal','l_none','{{js:Priority: Normal}}');
 h+=mi(u+'priohigh','high','{{js:Priority: High}}');
 h+=mi(u+'prioauto','l_none','{{js:Priority: Auto}}');
 h+=SEP;
 h+=mi('w=transfer&op=clearcompleted','m_clearcompleted','{{js:Clear Completed}}');
 m.innerHTML=h;
 showMenu(e,m);
}

function servermenu(e,ip,port){
 var m=document.getElementById('servermenu');
 var s='w=server';
