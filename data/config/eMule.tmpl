<--TMPL_HEADER-->
<!DOCTYPE html>
<html lang="[HtmlLang]">
<head>
<meta charset="[CharSet]">
<meta http-equiv="pragma" content="no-cache">
<link rel="icon" href="favicon.ico">
<link rel="stylesheet" href="sprites.css">
<link rel="stylesheet" href="sprite-rating.css">
<title>[eMuleAppName] [version] - [WebControl]</title>
[StyleSheet]
<script>
var activeMenu=null;
function showMenu(e,m){hideMenu();m.style.left=e.pageX+'px';m.style.top=e.pageY+'px';m.style.display='block';activeMenu=m;e.preventDefault();}
function hideMenu(){if(activeMenu){activeMenu.style.display='none';activeMenu=null;}}
document.addEventListener('click',hideMenu);

// Labels arrive as plain text in the page's language; every one is escaped on its way into markup.
function esc(s){return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');}
function ic(n){return '<span class="icon icon-'+n+'"></span> ';}
function mi(href,icon,label,question){return '<a class="menuitems" href="'+esc(href)+'"'+(question?' data-q="'+esc(question)+'" onclick="return confirm(this.dataset.q)"':'')+'>'+ic(icon)+esc(label)+'</a>';}
var SEP='<div class="menusep"></div>';
function setlang(code){var q=new URLSearchParams(location.search);q.set('setlang',code);location.search=q.toString();}

function downmenu(e,ses,hash,st){
 var m=document.getElementById('downmenu');
 var h='';
 var u='?ses='+encodeURIComponent(ses)+'&w=transfer&file='+encodeURIComponent(hash)+'&op=';
 if(st==='paused'||st==='stopped')
  h+=mi(u+'resume','l_resume','{{js:Resume}}');
 if(st==='downloading'||st==='waiting')
  h+=mi(u+'pause','l_pause','{{js:Pause}}')+mi(u+'stop','l_stop','{{js:Stop}}');
 if(st==='paused')
  h+=mi(u+'stop','l_stop','{{js:Stop}}');
 h+=SEP;
 h+=mi(u+'cancel','l_cancel','{{js:Cancel}}','{{js:Cancel this download?}}');
 h+=SEP;
 h+=mi(u+'priolow','low','{{js:Priority: Low}}');
 h+=mi(u+'prionormal','l_none','{{js:Priority: Normal}}');
 h+=mi(u+'priohigh','high','{{js:Priority: High}}');
 h+=mi(u+'prioauto','l_none','{{js:Priority: Auto}}');
 h+=SEP;
 h+=mi('?ses='+encodeURIComponent(ses)+'&w=transfer&op=clearcompleted','m_clearcompleted','{{js:Clear Completed}}');
 m.innerHTML=h;
 showMenu(e,m);
}

function servermenu(e,ses,ip,port){
 var m=document.getElementById('servermenu');
 var s='?ses='+encodeURIComponent(ses)+'&w=server';
 var u=s+'&ip='+encodeURIComponent(ip)+'&port='+encodeURIComponent(port)+'&c=';
 var h='';
 h+=mi(u+'connect','l_connect','{{js:Connect}}');
 h+=mi(s+'&c=disconnect','l_close','{{js:Disconnect}}');
 h+=SEP;
 h+=mi(u+'remove','l_remove','{{js:Remove}}');
 h+=mi(u+'addtostatic','l_static','{{js:Add to Static}}');
 h+=mi(u+'removefromstatic','l_remove','{{js:Remove from Static}}');
 h+=SEP;
 h+=mi(u+'priolow','low','{{js:Priority: Low}}');
 h+=mi(u+'prionormal','l_none','{{js:Priority: Normal}}');
 h+=mi(u+'priohigh','high','{{js:Priority: High}}');
 m.innerHTML=h;
 showMenu(e,m);
}

function sharedmenu(e,link){
 var m=document.getElementById('sharedmenu');
 m.innerHTML='<a class="menuitems" href="#">'+ic('l_ed2klink')+esc('{{js:Copy ED2K Link}}')+'</a>';
 m.firstChild.onclick=function(){if(navigator.clipboard)navigator.clipboard.writeText(link);hideMenu();return false;};
 showMenu(e,m);
}
</script>
</head>
<body>

<div class="topbar">
 <table border="0" cellpadding="0" cellspacing="0" width="100%">
  <tr>
   <td class="topbar-left">
    <span class="icon icon-h_emule" style="vertical-align:middle"></span>
    <b>[eMuleAppName] [version]</b>
   </td>
   <td class="topbar-right" align="right">
    <span class="status-text">[ServerName]</span>
    &nbsp;&nbsp;
    <span class="icon icon-arrow_down" style="vertical-align:middle"></span> [SpeedDown] {{KB/s}}
    &nbsp;
    <span class="icon icon-arrow_up" style="vertical-align:middle"></span> [SpeedUp] {{KB/s}}
    &nbsp;&nbsp;|&nbsp;&nbsp;
    <select class="lang-select" title="{{Language}}" onchange="setlang(this.value)">[LanguageOptions]</select>
    &nbsp;&nbsp;|&nbsp;&nbsp;
    <a href="?ses=[ses]&amp;w=logout"><span class="icon icon-l_logout" style="vertical-align:middle"></span> {{Logout}}</a>
   </td>
  </tr>
 </table>
</div>

