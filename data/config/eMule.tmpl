<div class="section-header">
 <span class="icon icon-h_usenet" style="width:16px;height:16px;background-size:16px 16px;vertical-align:middle"></span>&nbsp; {{Usenet}}
</div>
<div class="un-toolbar">
 <a class="un-btn admin-only" href="#" onclick="unAddPanel(true);return false;"><span class="icon icon-l_add"></span>{{Add NZB…}}</a>
 <span class="un-toolsep admin-only"></span>
 <a class="un-btn admin-only needs-sel" href="#" onclick="unAct('pause');return false;"><span class="icon icon-l_pause"></span>{{Pause}}</a>
 <a class="un-btn admin-only needs-sel" href="#" onclick="unAct('resume');return false;"><span class="icon icon-l_resume"></span>{{Resume}}</a>
 <a class="un-btn admin-only needs-sel" href="#" onclick="unRemove(false);return false;"><span class="icon icon-l_remove"></span>{{Remove}}</a>
 <span class="un-toolsep admin-only"></span>
 <a class="un-btn admin-only" id="un-enginebtn" href="#" onclick="unEngineToggle();return false;"><span class="icon icon-l_pause"></span><span class="un-enginetext">{{Pause All}}</span></a>
 <div class="un-cattabs">[UsenetCategoryTabs]</div>
</div>
<div id="un-notice" class="un-notice" hidden></div>
<div id="un-addpanel" class="un-panel" hidden>
 <table>
  <tr><td>{{NZB files:}}</td><td><input type="file" id="un-files" accept=".nzb" multiple></td></tr>
  <tr><td>{{NZB URLs:}}</td><td><textarea id="un-urls" placeholder="{{Paste one or more http(s) links to .nzb files here, one per line...}}"></textarea></td></tr>
  <tr><td>{{Password:}}</td><td><input type="password" id="un-pw" autocomplete="off"></td></tr>
  <tr><td>{{Category:}}</td><td><select id="un-cat">[UsenetCategoryOptions]</select>
   &nbsp; {{Priority:}} <select id="un-prio">[UsenetPriorityOptions]</select>
   &nbsp; <label><input type="checkbox" id="un-paused"> {{Add paused}}</label></td></tr>
  <tr><td></td><td><button type="button" onclick="unAddSubmit()">{{Add}}</button> <button type="button" onclick="unAddPanel(false)">{{Cancel}}</button></td></tr>
 </table>
</div>
<div id="un-list">[UsenetList]</div>
<div id="un-details" hidden></div>
<div id="un-chooser" class="un-chooser" hidden></div>
<script>
var UN={ses:'[Session]',token:'[StreamToken]',lang:'[WebLang]',admin:'[IsAdmin]'==='1',cat:[UsenetCat],sort:'[UsenetSort]',desc:'[UsenetDesc]',
 cats:([UsenetCategoriesJson]).list,levels:([UsenetLevelsJson]).list,units:([UsenetUnitsJson]).list,maxUrls:[UsenetMaxUrls],
 sel:{},open:{},cur:null,details:null,busy:false,again:false,tick:0,menuRow:null,menuId:null,menuFile:-1};
var UN_SEP='<div class="menusep"></div>';

function unSize(b){var u=UN.units,i=0;b=Number(b)||0;while(b>=1000&&i<4){b/=1024;i++;}return i?b.toFixed(2)+' '+u[i]:b+' '+u[0];}
// "%1".."%9" in a translated sentence.
function unFmt(s){var a=arguments;return String(s).replace(/%(\d)/g,function(m,i){return a[+i]==null?'':String(a[+i]);});}
function unQ(){return 'ses='+encodeURIComponent(UN.ses);}
function unNotice(msg,err){var n=document.getElementById('un-notice');if(!msg){n.hidden=true;return;}n.textContent=msg;n.className='un-notice'+(err?' error':'');n.hidden=false;}
function unForm(o){var p=[];Object.keys(o).forEach(function(k){[].concat(o[k]).forEach(function(v){p.push(k+'='+encodeURIComponent(v));});});return p.join('&');}
function unErr(j){return (j&&j.error&&j.error.message)||'{{js:That did not work.}}';}
function unPost(path,body,headers){
 return fetch(path+(path.indexOf('?')<0?'?':'&')+unQ(),{method:'POST',cache:'no-store',
  headers:headers||{'Content-Type':'application/x-www-form-urlencoded'},body:body})
  .then(function(r){return r.json().catch(function(){return {};}).then(function(j){j.status=r.status;return j;});})
  .catch(function(){return {status:0,error:{message:'{{js:Could not reach the eMule core.}}'}};});
}
function unItem(id){var rows=document.querySelectorAll('#un-list tr.un-item');for(var i=0;i<rows.length;i++){if(rows[i].dataset.id===id)return rows[i];}return null;}

// --- the list: selection, expanded rows and scroll position survive each poll
function unRestore(){
 var seen={};
 document.querySelectorAll('#un-list tr.un-item').forEach(function(tr){
  var id=tr.dataset.id,on=!!UN.sel[id];seen[id]=1;
  tr.classList.toggle('un-selected',on);
  var cb=tr.querySelector('.un-check');if(cb)cb.checked=on;
  var ex=tr.querySelector('.un-expander');if(ex)ex.innerHTML=tr.dataset.files==='0'?'':(UN.open[id]?'&#9662;':'&#9656;');
 });
 document.querySelectorAll('#un-list tr.un-file').forEach(function(tr){tr.hidden=!UN.open[tr.dataset.id];});
 Object.keys(UN.sel).forEach(function(id){if(!seen[id])delete UN.sel[id];});
 var any=Object.keys(UN.sel).length>0;
 document.querySelectorAll('.un-toolbar .needs-sel').forEach(function(b){b.classList.toggle('disabled',!any);});
 unEngineSync();
}
// Pause All / Resume All follows the list fragment, which the server renders with the engine state.
function unEngineSync(){
 var s=document.getElementById('un-summary'),b=document.getElementById('un-enginebtn');if(!s||!b)return;
 var p=s.dataset.enginePaused==='1';b.dataset.paused=p?'1':'0';
 b.querySelector('.icon').className='icon '+(p?'icon-l_resume':'icon-l_pause');
 b.querySelector('.un-enginetext').textContent=p?'{{js:Resume All}}':'{{js:Pause All}}';
}
function unEngineToggle(){
 var b=document.getElementById('un-enginebtn');
 unPost('/usenet/action',unForm({op:b.dataset.paused==='1'?'engineresume':'enginepause'})).then(function(j){
  if(j.status!==200)unNotice(unErr(j),true);
  unRefresh();
 });
}
function unRefresh(){
 if(UN.busy){UN.again=true;return;}
 UN.busy=true;
 var url=UN.details?('?'+unQ()+'&w=usenet&part=details&id='+encodeURIComponent(UN.details))
                   :('?'+unQ()+'&w=usenet&part=list&cat='+UN.cat+'&sort='+UN.sort+'&desc='+UN.desc);
 var marker=UN.details?'usenet-details':'usenet-list',box=document.getElementById(UN.details?'un-details':'un-list');
 fetch(url,{cache:'no-store'}).then(function(r){return r.text();}).then(function(html){
  // A login page instead of a fragment: the session ran out.
  if(html.indexOf(marker)<0){location.reload();return;}
  var y=window.scrollY;box.innerHTML=html;if(!UN.details)unRestore();window.scrollTo(0,y);
 }).catch(function(){}).then(function(){UN.busy=false;if(UN.again){UN.again=false;unRefresh();}});
}
setInterval(function(){
 if(document.hidden||activeMenu)return;
 UN.tick++;
 // Details every second, like the Qt dialog; the queue every two.
 if(UN.details||UN.tick%2===0)unRefresh();
},1000);

function unSelect(e,id){
 if(e.ctrlKey||e.metaKey){if(UN.sel[id])delete UN.sel[id];else UN.sel[id]=1;}
 else{UN.sel={};UN.sel[id]=1;}
 UN.cur=id;
}
var unList=document.getElementById('un-list');
unList.addEventListener('click',function(e){
 var a=e.target.closest('a[data-sort]');
 if(a){e.preventDefault();var c=a.dataset.sort;if(UN.sort===c)UN.desc=UN.desc==='1'?'0':'1';else{UN.sort=c;UN.desc='0';}unRefresh();return;}
 var tr=e.target.closest('tr.un-item,tr.un-file');if(!tr)return;
 var id=tr.dataset.id;
 if(e.target.classList.contains('un-expander')){if(UN.open[id])delete UN.open[id];else UN.open[id]=1;}
 else if(e.target.classList.contains('un-check')){if(e.target.checked)UN.sel[id]=1;else delete UN.sel[id];UN.cur=id;}
 else unSelect(e,id);
 unRestore();
});
unList.addEventListener('dblclick',function(e){var tr=e.target.closest('tr.un-item,tr.un-file');if(tr)unActivate(tr);});
unList.addEventListener('contextmenu',function(e){
 var tr=e.target.closest('tr.un-item,tr.un-file');
 if(tr){var id=tr.dataset.id;if(!UN.sel[id]){UN.sel={};UN.sel[id]=1;}UN.cur=id;unRestore();unMenu(e,tr);return;}
 if(!UN.admin)return;
 var m=document.getElementById('usenetmenu');m.innerHTML=unAddEntries();showMenu(e,m);
});

// --- double-click: a finished release opens, a file opens, anything else expands
function unActivate(tr){
 var id=tr.dataset.id;
 if(tr.classList.contains('un-file')){if(tr.dataset.final==='1')unOpenFile(tr);else unShowDetails(id);return;}
 if(tr.dataset.status==='complete'){unOpenPayload(tr);return;}
 if(UN.open[id])delete UN.open[id];else UN.open[id]=1;
 unRestore();
}
function unIncoming(rel,play){
 // The incoming pages have no session, so they are told the language.
 var q='token='+encodeURIComponent(UN.token)+'&lang='+encodeURIComponent(UN.lang);
 if(!rel)return '/api/v1/incoming?'+q;
 return play==='1'?'/api/v1/incoming?'+q+'&play='+encodeURIComponent(rel)
                  :'/api/v1/incoming/download?'+q+'&file='+encodeURIComponent(rel);
}
function unNothingYet(el){unNotice(unFmt('{{js:Nothing has completed yet for "%1".}}',el.dataset.name||'{{js:this download}}'),true);}
function unOpenPayload(el){if(el.dataset.payload!=='1'){unNothingYet(el);return;}window.open(unIncoming(el.dataset.open,el.dataset.play),'_blank');}
function unOpenFile(el){
 // A file outside the incoming folder has no browse address; the listing is the fallback.
 if(el.dataset.open){window.open(unIncoming(el.dataset.open,el.dataset.play),'_blank');return;}
 if(el.dataset.final==='1')window.open(unIncoming('',''),'_blank');else unShowDetails(el.dataset.id);
}
function unOpenFolder(el){
 if(!el||el.dataset.payload!=='1'){if(el)unNothingYet(el);return;}
 var rel=el.dataset.open||'',cut=rel.lastIndexOf('/');
 window.open(unIncoming('','')+(cut>0?'&path='+encodeURIComponent(rel.substring(0,cut)):''),'_blank');
}

// --- preview, with the archive-entry chooser
function unPreviewTarget(tr){
 if(!tr)return {file:-1,note:''};
 if(tr.classList.contains('un-file'))return {file:tr.dataset.preview==='1'?Number(tr.dataset.index):-1,note:tr.dataset.note};
 return {file:Number(tr.dataset.previewFile),note:tr.dataset.previewNote};
}
function unStreamUrl(id,file,entry){return '/api/v1/usenet/'+encodeURIComponent(id)+'/'+file+'/preview?token='+encodeURIComponent(UN.token)+(entry>=0?'&entry='+entry:'');}
function unPreview(id,file,note){
 if(file<0){unNotice(note||'{{js:Nothing here can be previewed yet.}}',true);return;}
 // Opened inside the click, or a popup blocker eats it once the listing returns.
 var win=window.open('about:blank','_blank'),started=Date.now();
 (function poll(){
  fetch('/usenet/entries?'+unQ()+'&id='+encodeURIComponent(id)+'&file='+file,{cache:'no-store'})
  .then(function(r){return r.json();}).then(function(j){
   var entries=j.entries||[],playable=entries.filter(function(x){return x.playable;});
   if(j.status===3){if(win)win.close();unNotice(j.note||'{{js:This archive cannot be previewed.}}',true);return;}
   if(j.status===1&&playable.length<2&&Date.now()-started<60000){setTimeout(poll,500);return;}
   if(playable.length<=1){if(win)win.location=unStreamUrl(id,file,playable.length?playable[0].entry:-1);return;}
   if(win)win.close();
   unChooser(id,file,entries,j.status===1);
  }).catch(function(){if(win)win.location=unStreamUrl(id,file,-1);});
 })();
}
function unChooser(id,file,entries,scanning){
 var h='<div class="section-header">'+esc('{{js:Preview File}}')+(scanning?' '+esc('{{js:(still scanning)}}'):'')+'</div>'
  +'<table class="data-table"><thead><tr><th class="left">'+esc('{{js:Name}}')+'</th><th>'+esc('{{js:Size}}')+'</th><th class="left">'+esc('{{js:Status}}')+'</th><th></th></tr></thead><tbody>';
 entries.forEach(function(x){
  h+='<tr><td class="left">'+esc(x.name)+'</td><td class="right">'+esc(unSize(x.size))+'</td><td class="left">'+esc(x.playable?'{{js:Playable}}':x.note)+'</td><td>'
   +(x.playable?'<a href="'+esc(unStreamUrl(id,file,x.entry))+'" target="_blank" onclick="unCloseChooser()">'+esc('{{js:Preview}}')+'</a>':'')+'</td></tr>';
 });
 h+='</tbody></table><div style="text-align:right;padding-top:6px">'
  +(scanning?'<button type="button" id="un-keepscan">'+esc('{{js:Keep Scanning}}')+'</button> ':'')
  +'<button type="button" onclick="unCloseChooser()">'+esc('{{js:Cancel}}')+'</button></div>';
 var box=document.getElementById('un-chooser');box.innerHTML=h;box.hidden=false;
 var k=document.getElementById('un-keepscan');if(k)k.onclick=function(){unCloseChooser();unPreview(id,file);};
}
function unCloseChooser(){document.getElementById('un-chooser').hidden=true;}

// --- context menus, mirroring the Qt window's. Labels are plain text.
function unMi(icon,label,js,bold){return '<a class="menuitems" href="#" onclick="hideMenu();'+js+';return false;">'+ic(icon)+(bold?'<b>'+esc(label)+'</b>':esc(label))+'</a>';}
function unMiOff(icon,label,title){return '<span class="menuitems" style="opacity:.5;cursor:default" title="'+esc(title||'')+'">'+ic(icon)+esc(label)+'</span>';}
function unAddEntries(){return unMi('l_add','{{js:Add NZB…}}','unAddPanel(true)')+unMi('l_ed2klink','{{js:Add NZB from URL…}}','unAddPanel(true,true)');}
function unMenu(e,tr){
 var id=tr.dataset.id,item=unItem(id),ids=Object.keys(UN.sel),one=ids.length===1,isFile=tr.classList.contains('un-file'),h='';
 if(UN.admin){
  h+=unAddEntries()+UN_SEP+unMi('l_pause','{{js:Pause}}',"unAct('pause')")+unMi('l_resume','{{js:Resume}}',"unAct('resume')")+UN_SEP;
  UN.levels.forEach(function(l){h+=unMi(l.p>0?'high':l.p<0?'low':'l_none',unFmt('{{js:Priority: %1}}',l.n),"unAct('priority',"+l.p+")");});
  if(UN.cats.length>1){h+=UN_SEP;UN.cats.forEach(function(c,i){h+=unMi('l_category',unFmt('{{js:Category: %1}}',c),"unAct('category',"+i+")");});}
  h+=UN_SEP+(one?unMi('l_options','{{js:Set Password…}}','unPassword()'):unMiOff('l_options','{{js:Set Password…}}'))+UN_SEP;
  h+=unMi('l_search','{{js:Check Availability}}',"unAct('check')");
 }
 var t=unPreviewTarget(isFile?tr:item);
 UN.menuId=id;UN.menuFile=t.file;
 h+=t.file>=0?unMi('filetype_video','{{js:Preview}}','unPreview(UN.menuId,UN.menuFile)'):unMiOff('filetype_video','{{js:Preview}}',t.note||'{{js:Nothing here can be previewed yet.}}');
 UN.menuRow=isFile?tr:item;
 var openable=isFile?tr.dataset.final==='1':(item&&item.dataset.status==='complete'&&item.dataset.payload==='1');
 h+=openable&&one?unMi('filetype_other','{{js:Open File}}',isFile?'unOpenFile(UN.menuRow)':'unOpenPayload(UN.menuRow)',true):unMiOff('filetype_other','{{js:Open File}}');
 h+=unMi('l_shared','{{js:Open Folder}}','unOpenFolder(unItem(UN.menuId))');
 h+=unMi('l_info','{{js:Details…}}','unShowDetails(UN.menuId)');
 if(UN.admin)h+=UN_SEP+unMi('l_remove','{{js:Remove}}','unRemove(false)')+unMi('l_cancel','{{js:Remove and Delete Files}}','unRemove(true)');
 var m=document.getElementById('usenetmenu');m.innerHTML=h;showMenu(e,m);
}
document.querySelectorAll('.un-cattab').forEach(function(a){
 a.addEventListener('click',function(e){
  e.preventDefault();UN.cat=Number(a.dataset.cat);
  document.querySelectorAll('.un-cattab').forEach(function(b){b.classList.toggle('active',b===a);});
  unRefresh();
 });
 a.addEventListener('contextmenu',function(e){
  if(!UN.admin)return;
  var c=Number(a.dataset.cat),m=document.getElementById('usenetmenu');
  m.innerHTML=unMi('l_pause','{{js:Pause}}',"unCatAct('pause',"+c+")")+unMi('l_resume','{{js:Resume}}',"unCatAct('resume',"+c+")")+unMi('l_cancel','{{js:Cancel}}',"unCatAct('cancel',"+c+")");
  showMenu(e,m);
 });
});

// --- actions
function unAct(op,v,ids){
 ids=ids||Object.keys(UN.sel);if(!ids.length)return;
 unPost('/usenet/action',unForm({op:op,id:ids,v:v==null?'':v})).then(function(j){
  if(j.status!==200)unNotice(unErr(j),true);else unNotice(j.message||'',!!j.message);
  unRefresh();
 });
}
function unCatAct(op,c){
 // It deletes every article already fetched for those releases, and there is no undo.
 if(op==='cancel'&&!confirm(unFmt('{{js:Remove every Usenet download in "%1" and delete its files?}}',c===0?'{{js:All}}':UN.cats[c])))return;
 unPost('/usenet/action',unForm({op:'cat'+op,v:c})).then(function(j){
  if(j.status!==200)unNotice(unFmt('{{js:Could not apply that to the category: %1}}',unErr(j)),true);
  unRefresh();
 });
}
function unRemove(del){
 var n=Object.keys(UN.sel).length;if(!n)return;
 if(del&&!confirm(unFmt('{{js:Remove %1 download(s) and delete the files already fetched?}}',n)))return;
 unAct(del?'removedelete':'remove');
}
function unPassword(){
 var id=Object.keys(UN.sel)[0],tr=unItem(id);if(!tr)return;
 // Never pre-filled: the core does not send the stored value.
 var pw=prompt(unFmt('{{js:Archive password for "%1":}}',tr.dataset.name),'');if(pw===null)return;
 if(pw===''&&tr.dataset.haspw==='1'&&!confirm('{{js:Remove the stored password for this download?}}'))return;
 unAct('password',pw,[id]);
}

// --- Add NZB: files and links, with the same options the Qt dialogs ask for
function unAddPanel(show,urlFirst){var p=document.getElementById('un-addpanel');p.hidden=!show;if(show)document.getElementById(urlFirst?'un-urls':'un-files').focus();}
function unAddOne(job,force){
 var o={category:document.getElementById('un-cat').value,priority:document.getElementById('un-prio').value,
        paused:document.getElementById('un-paused').checked?'1':'0'};
 var pw=document.getElementById('un-pw').value;
 if(force)o.force='1';
 if(job.url){o.url=job.url;o.password=pw;return unPost('/usenet/add',unForm(o));}
 // The body is the .nzb, so the passphrase rides a header rather than the URL.
 o.name=job.file.name;
 return unPost('/usenet/add?'+unForm(o),job.file,{'Content-Type':'application/x-nzb','X-Nzb-Password':encodeURIComponent(pw)});
}
function unAddSubmit(){
 var files=Array.prototype.slice.call(document.getElementById('un-files').files||[]);
 var urls=document.getElementById('un-urls').value.split(/\r?\n/).map(function(s){return s.trim();}).filter(Boolean);
 if(!files.length&&!urls.length){unNotice('{{js:Choose .nzb files or paste links first.}}',true);return;}
 if(urls.length>UN.maxUrls){unNotice(unFmt('{{js:Please add at most %1 links at a time.}}',UN.maxUrls),true);return;}
 var jobs=files.map(function(f){return {file:f,label:f.name};}).concat(urls.map(function(u){return {url:u,label:u};}));
 var added=0,failed=[],again=[],chain=Promise.resolve();
 unNotice(unFmt('{{js:Adding %1 NZB(s)…}}',jobs.length));
 jobs.forEach(function(job){chain=chain.then(function(){return unAddOne(job,false).then(function(j){
  if(j.status===200)added++;else if(j.outcome===4)again.push(job);else failed.push(job.label+': '+unErr(j));
 });});});
 chain.then(function(){
  // "Already downloaded" is a question, not a failure.
  if(!again.length||!confirm(unFmt('{{js:You have already downloaded %1 of these. Download them again?}}',again.length)+'\n\n'+again.map(function(x){return x.label;}).join('\n')))return;
  var more=Promise.resolve();
  again.forEach(function(job){more=more.then(function(){return unAddOne(job,true).then(function(j){
   if(j.status===200)added++;else failed.push(job.label+': '+unErr(j));
  });});});
  return more;
 }).then(function(){
  var msg=added?unFmt('{{js:Queued %1 NZB(s).}}',added):'';
  if(failed.length)msg+=(added?' ':'')+unFmt('{{js:These could not be added: %1}}',failed.join('; '));
  unNotice(msg,failed.length>0);
  if(added){unAddPanel(false);document.getElementById('un-files').value='';document.getElementById('un-urls').value='';document.getElementById('un-pw').value='';}
  unRefresh();
 });
}

// --- details
function unShowDetails(id){UN.details=id;document.getElementById('un-list').hidden=true;document.getElementById('un-details').hidden=false;unCloseChooser();unRefresh();}
function unCloseDetails(){UN.details=null;document.getElementById('un-details').hidden=true;document.getElementById('un-list').hidden=false;unRefresh();}
document.getElementById('un-details').addEventListener('dblclick',function(e){var tr=e.target.closest('tr.un-dfile');if(tr)unOpenFile(tr);});

// Enter mirrors the double-click, Alt+Enter opens Details.
document.addEventListener('keydown',function(e){
 if(e.key!=='Enter'||UN.details||!UN.cur||/INPUT|TEXTAREA|SELECT|BUTTON/.test(e.target.tagName))return;
 var tr=unItem(UN.cur);if(!tr)return;
 e.preventDefault();
 if(e.altKey)unShowDetails(UN.cur);else unActivate(tr);
});
if(!UN.admin)document.querySelectorAll('.admin-only').forEach(function(x){x.hidden=true;});
unRestore();
</script>
<--TMPL_USENET_END-->


