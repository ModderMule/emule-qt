  <div class="nav-tab [Page_kad]"><a href="?ses=[ses]&amp;w=kad"><span class="icon icon-h_kad"></span><br>{{Kad}}</a></div>
  <div class="nav-tab [Page_server]"><a href="?ses=[ses]&amp;w=server"><span class="icon icon-h_server"></span><br>{{Server}}</a></div>
  <div class="nav-tab [Page_search]"><a href="?ses=[ses]&amp;w=search"><span class="icon icon-h_search"></span><br>{{Search}}</a></div>
  <div class="nav-tab [Page_shared]"><a href="?ses=[ses]&amp;w=shared"><span class="icon icon-h_shared"></span><br>{{Shared}}</a></div>
  <div class="nav-tab [Page_usenet]"><a href="?ses=[ses]&amp;w=usenet"><span class="icon icon-h_usenet"></span><br>{{Usenet}}</a></div>
  <div class="nav-tab [Page_stats]"><a href="?ses=[ses]&amp;w=stats"><span class="icon icon-h_statistic"></span><br>{{Statistics}}</a></div>
  <div class="nav-tab [Page_graphs]"><a href="?ses=[ses]&amp;w=graphs"><span class="icon icon-h_graph"></span><br>{{Graphs}}</a></div>
