<--TMPL_SCHEDULER-->
<div class="section-header">
 <span class="icon icon-l_scheduler" style="vertical-align:middle"></span>&nbsp; <b>{{Scheduler}}</b>
</div>
<div class="bulkbar">
 <label><input type="checkbox" [SchedulerChecked] [FormOff] onchange="post('w=scheduler&amp;op=enable&amp;on='+(this.checked?'1':'0'))"> {{Enable scheduler}}</label>
</div>
<table class="data-table">
 <thead>
  <tr>
   <th class="chk">{{On}}</th>
   <th class="left">{{Title}}</th>
   <th>{{Days}}</th>
   <th>{{Time}}</th>
   <th class="left">{{Actions}}</th>
   <th></th>
  </tr>
 </thead>
 <tbody>[ScheduleLines]</tbody>
</table>
<br>
<form action="/" method="POST" class="search-form sched-add admin-only">
 <input type="hidden" name="w" value="scheduler">
 <input type="hidden" name="op" value="add">
 <b>{{New Schedule}}</b>
 <table>
  <tr><td>{{Title}}</td><td><input type="text" name="title" size="30"></td></tr>
  <tr><td>{{Days}}</td><td><select name="day">[ScheduleDayOptions]</select></td></tr>
  <tr><td>{{Time}}</td><td><input type="time" name="start" value="00:00" required> &ndash; <input type="time" name="end"> <span class="flt-count">{{Empty end: no end time}}</span></td></tr>
  <tr><td>{{Action}}</td><td><select name="action" id="sched-action">[ScheduleActionOptions]</select> <input type="text" name="value" id="sched-value" size="8" placeholder="{{Value}}" aria-label="{{Value}}"></td></tr>
  <tr><td></td><td><input type="submit" value="{{Add}}" [FormOff]></td></tr>
 </table>
 <span class="flt-count">{{More actions per schedule: Preferences › Scheduler in the eMule window.}}</span>
</form>
<script>
(function(){
 if(!ADMIN)document.querySelectorAll('.page-content .admin-only').forEach(function(x){x.hidden=true;});
 var a=document.getElementById('sched-action'),v=document.getElementById('sched-value');
 function sync(){var o=a.options[a.selectedIndex];v.hidden=!o||o.getAttribute('data-value')!=='1';}
 if(a){a.addEventListener('change',sync);sync();}
})();
</script>
<--TMPL_SCHEDULER_END-->


<--TMPL_SCHEDULE_LINE-->
