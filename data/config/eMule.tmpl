<style>
/* === Base === */
body {
  margin: 0; padding: 0;
  font-family: Tahoma, Verdana, Arial, sans-serif;
  font-size: 8pt;
  background: #005784;
  color: #FFFFFF;
}
a:active, a:link, a:visited { color: #FFFFFF; text-decoration: none; }
a:hover { color: #FFC412; text-decoration: none; }
form { display: inline; }
img { border: 0; }

/* === Top bar === */
.topbar {
  background: #003C6E;
  padding: 6px 12px;
  border-bottom: 1px solid #002244;
}
.topbar-left { font-size: 9pt; }
.topbar-right { font-size: 8pt; white-space: nowrap; }
.status-text { color: #99CCFF; }
.lang-select { font-size: 7.5pt; background: #1F76A5; color: #FFFFFF; border: 1px solid #002244; }

/* === Navigation === */
.nav {
  display: flex; align-items: stretch;
  background: #1F76A5;
  border-bottom: 2px solid #003C6E;
  padding: 0;
}
.nav-main {
  display: flex; align-items: stretch;
  flex: 1;
}
.nav-tab {
  padding: 6px 12px 4px;
  text-align: center;
  white-space: nowrap;
}
.nav-tab a {
  display: flex; flex-direction: column; align-items: center;
  color: #FFFFFF; font-weight: bold; font-size: 7.5pt;
  text-decoration: none;
}
.nav-tab a:hover { color: #FFC412; }
.nav-tab .icon { margin-bottom: 2px; }
.nav-tab.active {
  background: #005784;
  border-bottom: 3px solid #FFC412;
}
.nav-tab.active a { color: #FFC412; }
.nav-right {
  display: flex; flex-direction: column; justify-content: center;
  padding: 4px 12px; white-space: nowrap; font-size: 7.5pt;
  line-height: 1.5;
}
.nav-link { color: #FFFFFF; text-decoration: none; }
.nav-link:hover { color: #FFC412; }
.nav-link.active { color: #FFC412; font-weight: bold; }

/* === Page content === */
.page-content { padding: 8px 12px; }

/* === Section headers === */
.section-header {
  background: #000000;
  padding: 4px 8px;
  font-weight: bold;
  font-size: 8pt;
}

/* === Table styles === */
.data-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 8pt;
}
.data-table th {
  background: #005784;
  padding: 3px 6px;
  text-align: center;
  font-weight: bold;
  white-space: nowrap;
}
.data-table th a { color: #FFFFFF; }
.data-table th a:hover { color: #FFC412; }
.data-table th.left { text-align: left; }
.data-table td {
  padding: 2px 6px;
  background: #1F76A5;
  border-bottom: 1px solid #005784;
  white-space: nowrap;
}
.data-table td.left { text-align: left; }
.data-table td.right { text-align: right; }
.data-table td.center { text-align: center; }

/* === Download status colors === */
.dl-downloading, .dl-downloading a { color: #00FF00; }
.dl-paused, .dl-paused a { color: #C1C1C1; }
.dl-complete, .dl-complete a { color: #1D3445; }
.dl-error, .dl-error a { color: #FF4040; }
.dl-waiting, .dl-waiting a { color: #FFFFFF; }
.dl-hashing, .dl-hashing a { color: #FFFF00; }
.dl-stalled, .dl-stalled a { color: #FFC412; }
.dl-stopped, .dl-stopped a { color: #A0A0A0; }

/* === Upload status colors === */
.ul-uploading, .ul-uploading a { color: #00FF00; }
.ul-connecting, .ul-connecting a { color: #FFFFFF; }

/* === Server status colors === */
.srv-connected, .srv-connected a { color: #00FF00; }
.srv-disconnected, .srv-disconnected a { color: #FFFFFF; }

/* === Progress bar === */
.progress-bar {
  background: #000000;
  border: 1px solid #333;
  height: 13px;
  width: 200px;
  display: inline-block;
  vertical-align: middle;
  position: relative;
}
.confidence-likely_fake { color:#D00000; font-weight:bold; }
.confidence-suspect { color:#D06000; }
.confidence-caution { color:#A08000; }
.confidence-genuine { color:#008000; }
.progress-fill {
  background: #00AA00;
  height: 100%;
  transition: width 0.3s;
}
.progress-text {
  position: absolute;
  width: 100%;
  text-align: center;
  font-size: 7pt;
  line-height: 13px;
  color: #FFFFFF;
  top: 0; left: 0;
}

/* === Shared / common panel === */
.commontext {
  background: #FFFFFF;
  color: #000000;
  font-size: 8pt;
  padding: 8px;
}
.smallheader {
  background: #003C6E;
  color: #FFFFFF;
  padding: 3px 6px;
  font-size: 8pt;
}

/* === Search form === */
.search-form {
  background: #1F76A5;
  padding: 8px;
}
.search-form td { padding: 3px 6px; font-size: 8pt; }
.search-form input[type="text"],
.search-form select {
  border: 1px dotted #000;
  padding: 2px 4px;
  font-size: 8pt;
}

/* === Preferences === */
.pref-section { background: #005784; padding: 4px 8px; font-weight: bold; }
.pref-row { background: #2184B5; padding: 4px 8px; }
.pref-row input[type="text"] {
  border: 1px dotted #000;
  padding: 2px 4px;
  font-size: 8pt;
  width: 60px;
}

/* === Log === */
.log-box {
  background: #FFFFFF;
  color: #000000;
  font-family: "Lucida Console", monospace;
  font-size: 8pt;
  padding: 8px;
  white-space: pre-wrap;
  max-height: 500px;
  overflow-y: auto;
}

/* === Footer row (table totals) === */
.data-table tfoot td {
  background: #005784;
  font-weight: bold;
  font-size: 7.5pt;
}

/* === Graphs === */
.graph-container {
  border: 1px solid green;
  height: 150px;
  background: url(stats_back.gif);
  position: relative;
}

/* === Kad === */
.kad-table {
  width: 40%;
  margin: 0 auto;
  border-collapse: collapse;
}
.kad-table td {
  background: #2184B5;
  padding: 4px 8px;
  font-size: 9pt;
}

/* === Misc === */
.message { font-weight: bold; background: #005784; padding: 4px 8px; }

/* === Context menus === */
.popmenu {
  position:absolute; background:#005784; border:1px solid #000;
  padding:0; z-index:100; display:none; min-width:140px;
  line-height:18px; font:normal 12px Tahoma;
}
.popmenu a, .popmenu a:link, .popmenu a:visited { color:#fff; text-decoration:none; }
.menuitems {
  padding:2px 6px; white-space:nowrap; cursor:pointer; display:block;
  font-size:8pt;
}
.menuitems:hover { background:#003C6E; }
.menuitems .icon { vertical-align:middle; margin-right:4px; background-color:#003C6E; border:2px #003C6E solid; }
.menusep { border-top:1px solid #003C6E; margin:0; }

/* === Usenet === */
[hidden] { display:none !important; }
.un-toolbar { display:flex; align-items:center; flex-wrap:wrap; gap:2px; background:#003C6E; padding:3px 6px; }
.un-btn { display:inline-flex; align-items:center; gap:4px; padding:2px 8px; border:1px solid transparent; cursor:pointer; }
.un-btn:hover { border-color:#1F76A5; }
.un-btn.disabled { opacity:.45; pointer-events:none; }
.un-toolsep { width:1px; height:16px; background:#1F76A5; margin:0 4px; }
.un-cattabs { margin-left:auto; display:flex; flex-wrap:wrap; gap:2px; }
.un-cattab { padding:2px 10px; background:#1F76A5; border:1px solid #005784; }
.un-cattab.active { background:#005784; border-bottom:2px solid #FFC412; font-weight:bold; }
.un-table tr.un-item td { cursor:default; }
.un-table tr.un-selected td { background:#2E8FC2; }
.un-table tr.un-active td { font-weight:bold; }
.un-table tr.un-failed td { color:#FF7070; }
.un-table tr.un-paused td { color:#C1C1C1; }
.un-table tr.un-post td { color:#9FD4FF; font-weight:bold; }
.un-table tr.un-post .progress-fill { background:#3399FF; }
.un-table tr.un-file td { background:#2A86B8; }
.un-table td.un-fname { padding-left:34px; }
.data-table tr.un-par2 td { color:#B8C8D4; }
.data-table tr.tf-skip td { color:#888888; }
.un-table .progress-bar { width:110px; }
.un-expander { display:inline-block; width:14px; text-align:center; cursor:pointer; }
.un-lock { margin-right:3px; }
.un-summary { background:#003C6E; padding:3px 8px; }
.un-notice { background:#005784; padding:4px 8px; margin:4px 0; }
.un-notice.error { color:#FFB0B0; }
.un-panel { background:#1F76A5; border:1px solid #003C6E; padding:6px; margin:4px 0; }
.un-panel td { padding:3px 6px; vertical-align:top; }
.un-panel textarea { width:460px; max-width:100%; height:60px; font-size:8pt; }
.un-panel input, .un-panel select, .un-panel button { font-size:8pt; }
.un-details-title { font-size:11pt; font-weight:bold; padding:6px 0; }
.un-details-grid { display:grid; grid-template-columns:auto 1fr auto 1fr; gap:3px 12px; margin-bottom:8px; }
.un-details-grid .k { color:#99CCFF; }
.un-chooser { position:fixed; left:50%; top:25%; transform:translateX(-50%); background:#005784; border:1px solid #000; padding:8px; z-index:200; min-width:380px; }

/* === Header controls, notices, drag and drop === */
.topbar { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:4px 12px; }
.topbar-right { display:flex; align-items:center; flex-wrap:wrap; gap:4px 10px; justify-content:flex-end; }
.hdr-speeds { white-space:nowrap; }
.hdr-btn { white-space:nowrap; padding:1px 4px; }
.nav-tab a { position:relative; }
/* two columns, so a fifth link does not make the bar taller */
.nav-right { display:grid; grid-template-columns:auto auto; gap:0 14px; align-content:center; }
.nav-right br { display:none; }
.badge { position:absolute; top:-2px; right:-6px; background:#D00000; color:#fff; border-radius:8px; padding:0 5px; font-size:7pt; line-height:14px; }
.ui-notice { margin:6px 12px 0; padding:4px 8px; background:#005784; border-left:3px solid #00CC00; font-weight:bold; }
.ui-notice.failed { border-left-color:#FF4040; color:#FFB0B0; }
.toasts { position:fixed; right:12px; bottom:12px; z-index:300; display:flex; flex-direction:column; gap:6px; max-width:min(420px, calc(100vw - 24px)); }
.toast { background:#003C6E; border:1px solid #002244; border-left:4px solid #00CC00; padding:6px 10px; font-size:8.5pt; box-shadow:0 2px 8px rgba(0,0,0,.4); cursor:pointer; transition:opacity .4s; word-break:break-word; }
.toast.failed { border-left-color:#FF4040; }
.toast.gone { opacity:0; }
.dropzone { position:fixed; inset:0; z-index:400; background:rgba(0,40,80,.75); display:flex; align-items:center; justify-content:center; pointer-events:none; }
.dropzone div { border:3px dashed #FFC412; padding:40px 60px; font-size:14pt; font-weight:bold; color:#fff; text-align:center; max-width:80vw; }
.speedmenu { padding:4px; min-width:300px; }
.sm-cols { display:flex; gap:8px; }
.sm-col { flex:1; }
.sm-head { font-weight:bold; padding:2px 6px; border-bottom:1px solid #003C6E; margin-bottom:2px; }
.sm-cur { font-weight:bold; color:#FFC412 !important; }
.sm-own { padding:4px 6px; }
.sm-own input { width:70px; }
.sm-foot { padding:4px 6px; border-top:1px solid #003C6E; display:flex; align-items:center; justify-content:space-between; gap:8px; }

/* === List filter and bulk actions === */
.filterbar { display:flex; align-items:center; gap:6px; padding:3px 6px; background:#003C6E; }
.filterbar input[type="search"] { width:220px; max-width:60vw; padding:2px 4px; font-size:8pt; }
.filterbar select { font-size:8pt; }
.flt-count { color:#99CCFF; }
.bulkbar { display:flex; align-items:center; flex-wrap:wrap; gap:4px; padding:3px 6px; background:#003C6E; }
.bulkbar button, .bulkbar select { font-size:8pt; }
.data-table td.chk, .data-table th.chk { width:18px; text-align:center; }

/* === ed3k, Messages, Scheduler, Add Link === */
.ed3k-status { width:60%; margin:6px auto; }
.msg-wrap { display:flex; gap:8px; align-items:flex-start; }
.msg-friends { flex:0 0 340px; max-width:100%; }
.msg-chat { flex:1; min-width:0; }
.data-table tr.active td { background:#2E8FC2; }
.friend-online { color:#00FF00; }
.chat-log { background:#FFFFFF; color:#000; height:360px; overflow-y:auto; padding:6px 8px; font-size:9pt; }
.chat-line { padding:1px 0; word-wrap:break-word; }
.chat-line .chat-time { color:#808080; font-size:7.5pt; }
.chat-in b { color:#0050A0; }
.chat-out b { color:#A05000; }
.chat-form { display:flex; gap:4px; padding:4px 0; }
.chat-form input[type="text"] { flex:1; padding:4px; font-size:9pt; }
.add-friend input { width:120px; }
form.add-friend, form.sched-add { display:block; margin-top:6px; }
.sched-add td { padding:3px 6px; }
.addlink-box textarea { width:100%; box-sizing:border-box; height:120px; font-size:8.5pt; }

/* === Phones === */
@media (max-width: 760px) {
  body { font-size:9pt; }
  .topbar { padding:6px 8px; }
  .topbar-right { justify-content:flex-start; }
  .nav { flex-direction:column; }
  .nav-main { overflow-x:auto; -webkit-overflow-scrolling:touch; scrollbar-width:thin; }
  .nav-tab { padding:4px 8px 2px; }
  .nav-right { display:flex; flex-direction:row; flex-wrap:wrap; gap:2px 14px; padding:4px 8px; line-height:2; }
  .nav-right br { display:none; }
  .page-content { padding:6px 4px; }
  [data-live], .table-scroll { overflow-x:auto; -webkit-overflow-scrolling:touch; }
  .data-table .opt { display:none; }
  .data-table td.left { white-space:normal; word-break:break-word; min-width:120px; }
  .progress-bar { width:64px; }
  table[width] { width:100% !important; }
  .kad-table, .ed3k-status { width:100%; }
  .menuitems { padding:8px 10px; font-size:10pt; }
  input, select, textarea, button { font-size:16px !important; }
  .search-form textarea, .un-panel textarea { width:100%; box-sizing:border-box; }
  .msg-wrap { flex-direction:column; }
  .msg-friends { flex:none; width:100%; }
  .chat-log { height:50vh; }
  .speedmenu { min-width:0; width:calc(100vw - 24px); }
  .sm-cols { flex-direction:column; }
  .un-chooser { min-width:0; width:calc(100vw - 24px); }
  .un-cattabs { margin-left:0; }
}

/* === Themes: classic is the rules above; dark and light override them === */
html[data-theme="dark"] body { background:#1B1D22; color:#E4E6EA; }
html[data-theme="dark"] .topbar { background:#121418; border-bottom-color:#000; }
html[data-theme="dark"] .status-text, html[data-theme="dark"] .flt-count { color:#9FB4CC; }
html[data-theme="dark"] .nav { background:#24272E; border-bottom-color:#121418; }
