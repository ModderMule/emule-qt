# Values needed for tests. Copy to .env and fill in your own values. .env is git-ignored; this file is not.
#
# Tests read this file through eMule::testing::loadProjectEnv(); a real
# environment variable always wins over the value here.
#
# Most of what follows only matters to the live tests, which are not built by
# default: configure with -DEMULE_LIVE_TESTS=ON, then run them deliberately with
# `ctest -L live`. `ctest -LE live` never reaches them.
#
# Anything left empty makes its test SKIP, not fail — an unconfigured checkout
# must not look broken.

# SMTP server used by tst_SmtpSendEmail (live test) and the e-mail notifier
SMTP_SERVER=smtp.example.com
SMTP_PORT=465
SMTP_TLS=true
SMTP_AUTH=1
SMTP_USER=you@example.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=you@example.com
SMTP_TO=you@example.com
SMTP_ALLOW_SELF_SIGNED=true

# Directory with real files, used by tst_SharedFileLargeSet::hashExternalPath
SHARED_FILES_TESTPATH=/path/to/a/folder/with/files

# Local ED2K server started by the live server tests.
# generates logs/enode.log in working dir
SERVER_TEST_CMD=/path/to/eNode-go/bin/main -config /path/to/eNode-go/enode.local.yaml

# Forwarded ports for tst_PortTestLive, tst_ServerConnectLive, tst_KadLiveNetwork
# and tst_FileDownloadLive. Set BOTH only if these ports really are forwarded to
# this machine: setting them is what makes those tests assert reachability —
# open port-test results, and a HighID from the ED2K server. Unset, each test
# binds a firewalled port instead and expects the closed/LowID outcome, so a
# wrong value here fails the test rather than skipping it.
#EMULE_TCP_PORT=5662
#EMULE_UDP_PORT=5672

# Optional knobs for tst_ServerConnectLive, the server-connect diagnostic. Its
# header comment says what each one is for and what it found. Values below are
# the defaults, except the last three, which are off unless set.
#   EMULE_SEARCH_KEYWORD       global-search keyword
#   EMULE_CONNECT_TIMEOUT_MS   per-server connect budget
#   EMULE_CONNECT_MAX_SERVERS  cap on servers tried
#   EMULE_CONNECT_NOCRYPT=0    obfuscated login instead of plain, to reproduce its stall
#   EMULE_SMART_LOWID=1        re-enable smart-LowID, which bounces off every LowID
#   EMULE_LOG_RAW=1            dump raw handshake/login bytes for wire inspection
#EMULE_SEARCH_KEYWORD=eMule
#EMULE_CONNECT_TIMEOUT_MS=12000
#EMULE_CONNECT_MAX_SERVERS=10
#EMULE_CONNECT_NOCRYPT=0
#EMULE_SMART_LOWID=1
#EMULE_LOG_RAW=1

# tst_PortTestLive additionally queries emule-qt.org's port checker, which is a
# request to someone else's server, so it only runs when asked.
#EMULE_PORTTEST_QT=1

# Usenet provider for tst_UsenetLiveConnect and tst_UsenetLiveFetch. Without a
# host both skip. Credentials are optional — some providers are open — and the
# tests never write them anywhere.
EMULE_NNTP_HOST=
# EMULE_NNTP_PORT is optional: 563 for implicit TLS, 119 otherwise.
EMULE_NNTP_PORT=563
# implicit | starttls | none
EMULE_NNTP_TLS=implicit
EMULE_NNTP_USER=
EMULE_NNTP_PASS=

# tst_UsenetLiveFetch downloads one file out of this .nzb and CRC-checks every
# article. Give it something small and still within retention.
EMULE_NZB_FILE=
# Optional: SHA-256 of the assembled first file. Without it the test only
# checks that every article arrived and verified.
EMULE_NZB_SHA256=

# Indexer (newznab/torznab) account for tst_IndexerLiveSearch. All three are
# required and there are NO defaults — not even the hostname: naming an indexer
# here would make it this project's suggested provider, and the URL is as much
# your private account detail as the key is. Missing any one of them skips.
EMULE_INDEXER_APIKEY=
# The API base: a newznab host, or a Jackett/Prowlarr endpoint path.
EMULE_INDEXER_URL=
# A keyword that should match something at your indexer.
EMULE_INDEXER_QUERY=

# HTTP Cache backends for tst_HttpCacheLive -- every case runs once per backend
# that is present, and skips the ones that are not.
#
# php: an already-running deployment. Skipped when the web server is down.
EMULE_HTTPCACHE_URL=http://localhost/emule-http-cache-php
#EMULE_HTTPCACHE_KEY=<the secret from emule-http-cache-php/config.php>
#
# go: a binary the test starts itself, over a throwaway config and storage dir
# on a free loopback port. Skipped when the executable is missing.
HTTPCACHE_GO_CMD=/path/to/emule-http-cache-go/bin/emule-http-cache

# release publishing (scripts/publish-release.sh) -- all five are required
PUBLISH_SSH_USER=your-ssh-user
PUBLISH_SSH_PASS=your-ssh-password
PUBLISH_SSH_HOST=upload.example.com
PUBLISH_REMOTE_PATH=/home/youruser/domains/example.com/public_html/pub/
PUBLISH_LOCAL_JSON=/path/to/htdocs/pub/emuleqt-version.json
