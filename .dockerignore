build/
build2/
cmake-build-*/
out/
.git/
*.tar.gz
*.dmg
*.zip
*.app

# Rig artefacts: generated test files, per-node crash dirs and captured logs.
docker/*/seed/
docker/*/crashes/
docker/*/netmon/
docker/*/nodes.log

# Local-only trees: not part of the build. libs/packmule (its own, private repo)
# is built when present (docker.yml fetches it); never its cargo output
libs/*
!libs/packmule/
libs/packmule/target/
Testing/
Usenet/
dev/
*.log
# data/config is seeded, data/legacy is in the GUI resources; the rest is test data
data/*
!data/config/
!data/legacy/
